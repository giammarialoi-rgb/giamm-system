                                    "endLine": 6,
                                    "snippet": {
                                        "text": "distributionBase=GRADLE_USER_HOME\ndistributionPath=wrapper/dists\ndistributionUrl=https\\://services.gradle.org/distributions/gradle-9.7.0-bin.zip\nnetworkTimeout=10000\nvalidateDistributionUrl=true\n"
                                    }
                                }
                            }
                        }
                    ],
                    "fixes": [
