# NEVER commit a real API key.
# Add this variable in Render/Vercel/etc. Environment Variables / Secrets.
GEMINI_API_KEY=

# Optional: change the port locally. Render supplies PORT automatically.
PORT=10000

# Default Gemini model for document analysis and chat.
GEMINI_MODEL=gemini-3.1-flash-lite

# Health check (non-sensitive): GET /health or GET /api/health
# Returns: { ok, aiConfigured, model, accountStorageConfigured, googleOAuthConfigured }

# Comma-separated list of allowed browser origins.
# Development also allows localhost. Production is deny-by-default except the
# canonical Render origin and native/no-origin requests.
CORS_ORIGINS=

# Required for cross-device account storage.
DATABASE_URL=

# Required in production for signing account session tokens (minimum 32 chars).
JWT_SECRET=

# Fixed-window protection for auth and document import endpoints.
AUTH_RATE_LIMIT_MAX=40
IMPORT_RATE_LIMIT_MAX=20

# OAuth: Web client ID from Google Cloud Console (same as gradle googleWebClientId).
# Authorized JavaScript origins must include https://coach-api-gemini.onrender.com
GOOGLE_CLIENT_ID=846449169573-laa0kbkvq7mv9ufqb858dar8hvomco02.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Optional email delivery for password reset (Resend). Inline reset codes are
# development-only; production never returns a reset code in the response.
# MAIL_FROM example: NURVAN <noreply@yourdomain.com> (domain must be verified in Resend)
RESEND_API_KEY=
MAIL_FROM=

# Optional WebRTC TURN (mobile/NAT). Leave empty = STUN only via GET /api/webrtc/ice.
# Example TURN_URLS: turn:relay.example.com:3478,turns:relay.example.com:5349
# Never commit real credentials. Set these in Render Environment Variables.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Web Push (PWA / browser). Generate with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Set the same keys on Render. Subject must be a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@nurvan.app

# Android APK build (not server): pass at Gradle build time:
#   ./gradlew assembleDebug -PgoogleWebClientId=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
#   ./gradlew assembleDebug -PcoachApiUrl=https://coach-api-gemini.onrender.com
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=https://your-service.onrender.com/api/auth/apple/callback
APPLE_PRIVATE_KEY=

# Coach OS feature flags. All default to false until their phase ships.
NURVAN_FEATURE_COACH_SHELL_V2=false
NURVAN_FEATURE_COACH_TODAY_V2=false
NURVAN_FEATURE_COACH_OVERVIEW_V2=false
NURVAN_FEATURE_COACH_IMPORT_V2=false
NURVAN_FEATURE_COACH_TASKS_V1=false
NURVAN_FEATURE_CLIENT_TIMELINE_V1=false
NURVAN_FEATURE_CLIENT_INTELLIGENCE=false
NURVAN_FEATURE_CHECK_IN_CENTER_V1=false
NURVAN_FEATURE_AGENT_V1=false
NURVAN_FEATURE_SCHEDULING_V1=false
NURVAN_FEATURE_COACH_ANALYTICS_V1=false
NURVAN_FEATURE_BUSINESS_V1=false
NURVAN_FEATURE_INBOX_V2=false
