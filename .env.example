# NEVER commit a real API key.
# Add this variable in Render/Vercel/etc. Environment Variables / Secrets.
GEMINI_API_KEY=

# Optional: change the port locally. Render supplies PORT automatically.
PORT=10000

# Default Gemini model for document analysis and chat.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional comma-separated list of allowed browser origins.
# Leave empty to allow all origins during development.
CORS_ORIGINS=

# Required for cross-device account storage.
DATABASE_URL=

# Required for signing account session tokens. Use a long random secret.
JWT_SECRET=

# OAuth provider secrets/configuration. Leave empty until provider consoles are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=https://your-service.onrender.com/api/auth/apple/callback
APPLE_PRIVATE_KEY=
