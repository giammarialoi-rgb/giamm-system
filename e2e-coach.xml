g-clickable="false" password="false" selected="false" bounds="[28,247][1252,272]" /><node index="1" text="Come si migliora nei bicipiti?" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,281][1252,301]" /><node index="2" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,300][1252,351]"><node index="0" text="Per migliorare nello sviluppo dei bicipiti, all'interno della tua attuale programmazione, dobbiamo lavorare su tre pilastri: " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,302][869,322]" /><node index="1" text="intensità (RPE/RIR), esecuzione tecnica e sovraccarico progressivo." resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,302][1166,347]" /></node><node index="3" text='Attualmente il tuo programma prevede un volume fisso (3 serie da 10 reps) nel Giorno 3 e nella sessione "Bonus". Ecco come procedere in modo pratico:' resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,365][1252,391]" /><node index="4" text="1. Introduci il concetto di RIR (Reps in Reserve)" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,419][1252,439]" /><node index="5" text="Poiché nel tuo file i campi RPE/RIR sono impostati a `null`, significa che stai probabilmente lavorando a sensazione. Per crescere, devi arrivare vicino al cedimento tecnico." resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,448][1252,474]" /><node index="6" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,483][1252,508]"><node index="0" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,485][876,505]"><node index="0" text="Obiettivo:" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,485][96,505]" /><node index="1" text=" In ogni serie di bicipiti, fermati quando senti di poter fare al massimo altre 1-2 ripetizioni con una forma perfetta (" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,485][876,505]" /></node><node index="1" text="RIR 1-2*)." resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[875,485][943,505]" /></node><node index="7" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,517][1252,543]"><node index="0" text="* " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,519][39,539]" /><node index="1" text="Non superare il cedimento tecnico:" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[38,519][290,539]" /><node index="2" text=" Se per completare le 10 ripetizioni devi dondolare con la schiena o usare slancio, riduci il carico del 5-10% nella serie successiva." resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[289,519][1203,539]" /></node><node index="8" text="2. Modifica mirata della programmazione (Progressione)" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,571][1252,591]" /><node index="9" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,600][1252,651]"><node index="0" text="Ti suggerisco di aggiungere una " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,602][259,622]" /><node index="1" text="progressione lineare del carico" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[258,602][481,622]" /><node index="2" text=" basata sulla cronologia. Dato che hai già inserito un carico nella sessione 8, ecco la regola da seguire per le prossime sessioni:" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,602][1245,647]" /></node><node index="10" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,660][1252,710]"><node index="0" text="* " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,662][39,682]" /><node index="1" text="Se completi tutte le serie e le ripetizioni previste" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[38,662][386,682]" /><node index="2" text=" (3x10) con la tecnica corretta, aumenta il carico di un piccolo incremento (es. +0.5kg o +1kg per manubrio) nella sessione successiva." resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,662][1251,707]" /></node><node index="11" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,719][1252,745]"><node index="0" text="* " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,721][39,741]" /><node index="1" text="Se non raggiungi le ripetizioni target" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[38,721][300,741]" /><node index="2" text=", mantieni lo stesso peso nella sessione successiva finché non le chiudi tutte." resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[299,721][848,741]" /></node><node index="12" text="3. Focus sulla tecnica (Connessione mente-muscolo)" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[28,773][1252,793]" /><node index="13" text="Per i bicipiti, il carico è secondario rispetto alla tensione meccanica:" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="14" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]"><node index="0" text="* " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="1" text="Fase eccentrica:" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="2" text=" Controlla la discesa del manubrio/cavo (impiega circa 2-3 secondi). È qui che avviene il maggior danno muscolare." resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node><node index="15" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]"><node index="0" text="* " resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="1" text="Sosta in allungamento:" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="2" text=' Non "rimbalzare" in basso. Estendi quasi completamente il braccio ma mantieni il gomito fermo (non farlo oscillare avanti e indietro durante il movimento).' resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node><node index="16" text="4. Ottimizzazione degli esercizi" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="17" text="Il tuo programma prevede:" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="18" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]"><node index="0" text="" resource-id="" class="android.view.View" package="com.giammaria.system" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="1" text="Bicipiti manubri ss Tricipiti cavi* (Giorno 3)" resource-id="" class="android.widget.TextView" package="com.giammaria.system" content-desc="" checka